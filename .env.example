# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Feature Flags
VITE_LP_DEGREE_MARKETPLACE=1

# Edge Function Secrets (Set in Supabase Dashboard → Project Settings → Edge Functions)
# These are NOT stored in .env - they're managed in Supabase secrets
# OPENAI_API_KEY=sk-...
# CRON_SECRET=your-secret-for-scheduled-jobs
# RESEND_API_KEY=re_...

# Optional: For local development
# VITE_DEV_MODE=true
