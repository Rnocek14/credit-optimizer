# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Feature Flags
VITE_LP_DEGREE_MARKETPLACE=1

# Edge Function Secrets (Set in Supabase Dashboard → Project Settings → Edge Functions)
# These are NOT stored in .env - they're managed in Supabase secrets
# OPENAI_API_KEY=sk-...
# CRON_SECRET=your-secret-for-scheduled-jobs
# RESEND_API_KEY=re_...

# Optional: For local development
# VITE_DEV_MODE=true
# ── Affiliate / revenue config ────────────────────────────────────
# This is what turns outbound provider clicks into income. Everything
# works with these blank (links fall back to the plain provider URL),
# it just earns nothing. Fill each in as a program is approved.
#
# Two shapes per provider, checked in this order:
#   *_URL   full tracking deep link from the network (Impact/FlexOffers/CJ)
#   *_CODE  bare referral code, appended as ?ref=CODE
# See docs/MONETIZATION_RUNBOOK.md for where to get each one.

VITE_AFF_SOPHIA_URL=
VITE_AFF_SOPHIA_CODE=
VITE_AFF_STUDYCOM_URL=
VITE_AFF_STUDYCOM_CODE=
VITE_AFF_STRAIGHTERLINE_URL=
VITE_AFF_STRAIGHTERLINE_CODE=
